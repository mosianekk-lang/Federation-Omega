{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceops.local/schemas/cloud-provider-execution-receipt.schema.json",
  "title": "EvidenceOps Cloud Provider Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "receipt_type",
    "generated_at",
    "repository",
    "commit",
    "project_id",
    "project_number",
    "region",
    "actor",
    "operation",
    "result",
    "mutation_performed",
    "evidence"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 8},
    "receipt_type": {
      "enum": [
        "WIF_VERIFICATION",
        "INFRASTRUCTURE_INVENTORY",
        "SECRET_BINDING",
        "CLOUD_RUN_CANARY",
        "CLOUD_RUN_PROMOTION",
        "ROLLBACK",
        "CREDENTIAL_REVOCATION"
      ]
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "repository": {"const": "mosianekk-lang/Federation-Omega"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "project_id": {"type": "string", "minLength": 1},
    "project_number": {"type": "string", "pattern": "^[0-9]+$"},
    "region": {"type": "string", "minLength": 1},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_type", "principal_reference"],
      "properties": {
        "principal_type": {"enum": ["GITHUB_OIDC", "SERVICE_ACCOUNT", "OWNER_ADMIN", "RUNTIME"]},
        "principal_reference": {"type": "string", "minLength": 1}
      }
    },
    "operation": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "FAIL", "PARTIAL", "ROLLED_BACK"]},
    "mutation_performed": {"type": "boolean"},
    "provider_resource": {"type": "string"},
    "service_account": {"type": "string"},
    "service": {"type": "string"},
    "revision": {"type": "string"},
    "image_digest": {"type": "string"},
    "previous_ready_revision": {"type": "string"},
    "traffic_promoted": {"type": "boolean"},
    "rollback_performed": {"type": "boolean"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "artifact_name": {"type": "string"}
        }
      }
    },
    "open_gaps": {"type": "array", "items": {"type": "string"}},
    "contains_secret_values": {"const": false}
  }
}
