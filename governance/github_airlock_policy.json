{
  "policy_id": "FEDOMEGA-GITHUB-AIRLOCK-V2",
  "version": "2.0.1",
  "mode": "DEFAULT_DENY",
  "required_platform_controls": {
    "target_branch": "main",
    "require_pull_request": true,
    "required_status_check": "admission",
    "require_code_owner_review": true,
    "dismiss_stale_reviews": true,
    "require_last_push_approval": true,
    "require_linear_history": true,
    "require_signed_commits": true,
    "block_force_pushes": true,
    "block_deletions": true
  },
  "active_workflow_allowlist": [
    ".github/workflows/github-airlock.yml",
    ".github/workflows/evidenceops-resolve-ci.yml",
    ".github/workflows/public-repository-leak-guard.yml",
    ".github/workflows/superior-logic-ci.yml",
    ".github/workflows/evidenceops-fevx-adapter-verify.yml",
    ".github/workflows/ipep-audio-engine-v2-ci.yml",
    ".github/workflows/evidenceops-pst-corpus-v2-fanout-observer.yml",
    ".github/workflows/alpha-omega-commercial-provider-dispatch-fencing-release.yml"
  ],
  "allowed_events": {
    ".github/workflows/github-airlock.yml": ["pull_request", "merge_group", "push", "workflow_dispatch"],
    ".github/workflows/evidenceops-resolve-ci.yml": ["pull_request", "merge_group", "push", "workflow_dispatch"],
    ".github/workflows/public-repository-leak-guard.yml": ["pull_request", "push", "workflow_dispatch"],
    ".github/workflows/superior-logic-ci.yml": ["pull_request", "push"],
    ".github/workflows/evidenceops-fevx-adapter-verify.yml": ["pull_request", "push", "workflow_dispatch"],
    ".github/workflows/ipep-audio-engine-v2-ci.yml": ["pull_request", "merge_group", "push", "workflow_dispatch"],
    ".github/workflows/evidenceops-pst-corpus-v2-fanout-observer.yml": ["workflow_run", "workflow_dispatch"],
    ".github/workflows/alpha-omega-commercial-provider-dispatch-fencing-release.yml": ["pull_request", "push", "workflow_dispatch"]
  },
  "oidc_workflow_allowlist": [],
  "forbidden_repository_mutations": [
    "git push",
    "git commit",
    "git tag",
    "gh api --method post",
    "gh api --method put",
    "gh api --method patch",
    "gh api --method delete"
  ],
  "forbidden_source_paths": [
    "deployment_receipts/",
    "runtime-receipts/",
    "workflow-state/"
  ],
  "maximum_workflow_files_changed_per_pull_request": 3,
  "require_immutable_action_shas": true,
  "require_checkout_credentials_disabled": true,
  "require_concurrency": true,
  "proof_destination": "GITHUB_ACTIONS_ARTIFACT_OR_EXTERNAL_APPEND_ONLY_STORE",
  "source_repository_role": "SOURCE_CODE_ONLY",
  "automation_repository_role": "SEPARATE_PRIVATE_EXECUTION_PLANE"
}
