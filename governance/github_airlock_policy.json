{
  "policy_id": "FEDOMEGA-GITHUB-AIRLOCK-V2",
  "version": "2.9.5",
  "mode": "DEFAULT_DENY_WITH_EXECUTION_QUARANTINE",
  "required_platform_controls": {
    "target_branch": "main",
    "require_pull_request": true,
    "required_status_checks": ["admission", "contract", "scan"],
    "require_code_owner_review": false,
    "required_approving_review_count": 0,
    "dismiss_stale_reviews": true,
    "require_last_push_approval": false,
    "require_review_thread_resolution": true,
    "require_linear_history": true,
    "require_signed_commits": true,
    "block_force_pushes": true,
    "block_deletions": true
  },
  "active_workflow_allowlist": [
    ".github/workflows/github-airlock.yml",
    ".github/workflows/public-repository-leak-guard.yml",
    ".github/workflows/phoenix-emergency-freeze.yml",
    ".github/workflows/bubbles-command-bus.yml",
    ".github/workflows/bco-provider-readback-continuity.yml",
    ".github/workflows/caseforge-provider-readback-canary.yml",
    ".github/workflows/pfrd-omega-operator-auth-probe.yml",
    ".github/workflows/sovara-litellm-v2-3-provider-admission.yml",
    ".github/workflows/sovara-project-iam-bridge.yml",
    ".github/workflows/cios-production-lane.yml",
    ".github/workflows/frontier-runtime-qualification.yml",
    ".github/workflows/cfbe-observed-current-qualification.yml",
    ".github/workflows/superior-logic-maturation-shadow.yml",
    ".github/workflows/luno-observer-provider-binding.yml",
    ".github/workflows/deploy-gemini-gateway.yml",
    ".github/workflows/fo-wif-semantic-canary-v2.yml",
    ".github/workflows/cfbe-hyperleverage-attestation-v1.yml",
    ".github/workflows/fhu047-wif-least-privilege-apply-v1.yml",
    ".github/workflows/fhu047-admin-authority-graph-census-v2.yml"
  ],
  "allowed_events": {
    ".github/workflows/github-airlock.yml": ["pull_request", "merge_group", "push", "workflow_dispatch"],
    ".github/workflows/public-repository-leak-guard.yml": ["pull_request", "push", "workflow_dispatch"],
    ".github/workflows/phoenix-emergency-freeze.yml": ["push", "workflow_dispatch"],
    ".github/workflows/bubbles-command-bus.yml": ["pull_request", "push", "workflow_dispatch"],
    ".github/workflows/bco-provider-readback-continuity.yml": ["workflow_run"],
    ".github/workflows/caseforge-provider-readback-canary.yml": ["push"],
    ".github/workflows/pfrd-omega-operator-auth-probe.yml": ["push", "workflow_dispatch"],
    ".github/workflows/sovara-litellm-v2-3-provider-admission.yml": ["push", "workflow_dispatch"],
    ".github/workflows/sovara-project-iam-bridge.yml": ["push", "workflow_dispatch"],
    ".github/workflows/cios-production-lane.yml": ["pull_request", "push", "workflow_dispatch"],
    ".github/workflows/frontier-runtime-qualification.yml": ["pull_request", "push", "workflow_dispatch"],
    ".github/workflows/cfbe-observed-current-qualification.yml": ["pull_request", "push", "workflow_dispatch"],
    ".github/workflows/superior-logic-maturation-shadow.yml": ["push", "schedule", "workflow_dispatch"],
    ".github/workflows/luno-observer-provider-binding.yml": ["pull_request", "push", "workflow_dispatch"],
    ".github/workflows/deploy-gemini-gateway.yml": ["workflow_dispatch"],
    ".github/workflows/fo-wif-semantic-canary-v2.yml": ["issues"],
    ".github/workflows/cfbe-hyperleverage-attestation-v1.yml": ["issues"],
    ".github/workflows/fhu047-wif-least-privilege-apply-v1.yml": ["issues"],
    ".github/workflows/fhu047-admin-authority-graph-census-v2.yml": ["issues"]
  },
  "required_push_branches": {
    ".github/workflows/bubbles-command-bus.yml": ["main"],
    ".github/workflows/caseforge-provider-readback-canary.yml": ["main"],
    ".github/workflows/pfrd-omega-operator-auth-probe.yml": ["main"],
    ".github/workflows/sovara-litellm-v2-3-provider-admission.yml": ["main"],
    ".github/workflows/sovara-project-iam-bridge.yml": ["main"],
    ".github/workflows/cios-production-lane.yml": ["main"],
    ".github/workflows/frontier-runtime-qualification.yml": ["main"],
    ".github/workflows/cfbe-observed-current-qualification.yml": ["main"],
    ".github/workflows/superior-logic-maturation-shadow.yml": ["main"],
    ".github/workflows/luno-observer-provider-binding.yml": ["main"]
  },
  "oidc_workflow_allowlist": [
    ".github/workflows/sovara-litellm-v2-3-provider-admission.yml",
    ".github/workflows/cios-production-lane.yml",
    ".github/workflows/luno-observer-provider-binding.yml",
    ".github/workflows/deploy-gemini-gateway.yml",
    ".github/workflows/fo-wif-semantic-canary-v2.yml",
    ".github/workflows/cfbe-hyperleverage-attestation-v1.yml",
    ".github/workflows/fhu047-wif-least-privilege-apply-v1.yml",
    ".github/workflows/fhu047-admin-authority-graph-census-v2.yml"
  ],
  "attestations_write_workflow_allowlist": [
    ".github/workflows/cfbe-hyperleverage-attestation-v1.yml"
  ],
  "provider_mutation_workflow_allowlist": [
    ".github/workflows/fhu047-wif-least-privilege-apply-v1.yml"
  ],
  "provider_mutation_exact_issue_titles": {
    ".github/workflows/fhu047-wif-least-privilege-apply-v1.yml": "[FO-DISPATCH] FHU047_WIF_LEAST_PRIVILEGE_ONCE_20260901_0142_SAST"
  },
  "actions_write_workflow_allowlist": [".github/workflows/phoenix-emergency-freeze.yml"],
  "statuses_write_workflow_allowlist": [".github/workflows/phoenix-emergency-freeze.yml"],
  "forbidden_pattern_exceptions": {
    ".github/workflows/phoenix-emergency-freeze.yml": [
      "gh api --method put",
      "gh api -x put",
      "gh api --method post",
      "gh api -x post"
    ]
  },
  "forbidden_repository_mutations": [
    "git push",
    "git commit",
    "git tag",
    "gh api --method post",
    "gh api --method put",
    "gh api --method patch",
    "gh api --method delete",
    "gh api -x post",
    "gh api -x put",
    "gh api -x patch",
    "gh api -x delete"
  ],
  "forbidden_source_paths": ["deployment_receipts/", "runtime-receipts/", "workflow-state/"],
  "maximum_workflow_files_changed_per_pull_request": 3,
  "require_immutable_action_shas": true,
  "require_checkout_credentials_disabled": true,
  "require_concurrency": true,
  "proof_destination": "GITHUB_ACTIONS_ARTIFACT_OR_EXTERNAL_APPEND_ONLY_STORE",
  "provider_credential_reference_policy": {
    "admitted_source_contracts": [
      "governance/sovara_provider_credential_reference_v1.json",
      "ops/sovara_provider_credential_reference.py",
      "federation/capital_execution/venues/LUNO_OBSERVER_BINDING_CONTRACT.json"
    ],
    "secret_values_in_source": false,
    "secret_values_in_workflow_payloads": false,
    "secret_values_in_logs": false,
    "secret_values_in_receipts": false,
    "reference_presence_proves_provider_authority": false,
    "provider_promotion_requires_surface_specific_readback": true,
    "provider_probe_workflow": ".github/workflows/pfrd-omega-operator-auth-probe.yml",
    "provider_deployment_workflow": ".github/workflows/sovara-litellm-v2-3-provider-admission.yml",
    "project_iam_bridge_workflow": ".github/workflows/sovara-project-iam-bridge.yml",
    "luno_observer_deployment_workflow": ".github/workflows/luno-observer-provider-binding.yml",
    "gemini_provider_deployment_workflow": ".github/workflows/deploy-gemini-gateway.yml",
    "provider_deployment_workflow_source_write": false,
    "provider_deployment_workflow_proof_destination": "GITHUB_ACTIONS_ARTIFACT",
    "g0_identity_probe_workflow": ".github/workflows/fo-wif-semantic-canary-v2.yml",
    "artifact_attestation_workflow": ".github/workflows/cfbe-hyperleverage-attestation-v1.yml",
    "fhu047_one_use_repair_workflow": ".github/workflows/fhu047-wif-least-privilege-apply-v1.yml",
    "fhu047_authority_graph_census_workflow": ".github/workflows/fhu047-admin-authority-graph-census-v2.yml"
  },
  "source_repository_role": "QUARANTINED_SOURCE_WITH_EXACT_AIRLOCKED_PROVIDER_GATEWAYS",
  "automation_repository_role": "SEPARATE_PRIVATE_EXECUTION_PLANE_OR_EXACT_AIRLOCKED_GATEWAY",
  "execution_quarantine": {
    "keep_active": [
      ".github/workflows/github-airlock.yml",
      ".github/workflows/public-repository-leak-guard.yml",
      ".github/workflows/phoenix-emergency-freeze.yml",
      ".github/workflows/bubbles-command-bus.yml",
      ".github/workflows/bco-provider-readback-continuity.yml",
      ".github/workflows/caseforge-provider-readback-canary.yml",
      ".github/workflows/pfrd-omega-operator-auth-probe.yml",
      ".github/workflows/sovara-litellm-v2-3-provider-admission.yml",
      ".github/workflows/sovara-project-iam-bridge.yml",
      ".github/workflows/cios-production-lane.yml",
      ".github/workflows/frontier-runtime-qualification.yml",
      ".github/workflows/cfbe-observed-current-qualification.yml",
      ".github/workflows/superior-logic-maturation-shadow.yml",
      ".github/workflows/luno-observer-provider-binding.yml",
      ".github/workflows/deploy-gemini-gateway.yml",
      ".github/workflows/fo-wif-semantic-canary-v2.yml",
      ".github/workflows/cfbe-hyperleverage-attestation-v1.yml",
      ".github/workflows/fhu047-wif-least-privilege-apply-v1.yml",
      ".github/workflows/fhu047-admin-authority-graph-census-v2.yml"
    ],
    "provider_managed_active": ["dynamic/dependabot/dependabot-updates"],
    "provider_managed_control_plane": "DEPENDABOT_REPOSITORY_SETTINGS",
    "all_other_workflows": "DISABLED_MANUALLY",
    "provider_readback_required": true,
    "verified_commit_status": "phoenix-freeze/verified"
  }
}
