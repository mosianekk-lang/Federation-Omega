{
  "schema": "FEDERATION-FULLY-ESTABLISHED-GOLD-STANDARD-V1",
  "version": "1.0.0",
  "rule_id": "FED-RULE-FULLY-ESTABLISHED-GOLD-STANDARD-V1",
  "title": "Fully Established Is the Federation Gold Standard",
  "owner": "Kim Kagiso Mosiane",
  "authority": "FEDERATION_GLOBAL_COMPLETION_AND_PROMOTION_RULE",
  "effective_scope": [
    "connections",
    "integrations",
    "provider bindings",
    "automation",
    "deployments",
    "restorations",
    "migrations",
    "cutovers",
    "runtime activations",
    "operational capability claims"
  ],
  "gold_standard": "FULLY_ESTABLISHED",
  "terminal_rule": "No state below FULLY_ESTABLISHED may be accepted, promoted, closed, or reported as terminal completion.",
  "intermediate_state_rule": "Intermediate states may exist only as explicitly qualified work-in-progress states. They do not satisfy the directive and may not terminate the mission.",
  "lifecycle": [
    "DISCOVERED",
    "CONFIGURED",
    "REACHABLE",
    "AUTHENTICATED",
    "AUTHORIZED",
    "SEMANTICALLY_VERIFIED",
    "BIDIRECTIONAL",
    "OPERATIONAL",
    "RESILIENT",
    "FULLY_ESTABLISHED"
  ],
  "fully_established_requires": [
    "exact target identity",
    "forward transport",
    "intended identity authentication",
    "action-specific authorization",
    "forward semantic readback",
    "fresh readback",
    "reverse transport",
    "reverse semantic readback",
    "active monitoring and freshness lease",
    "idempotency and duplicate-effect suppression",
    "retry, DLQ, and replay proof",
    "failure-domain isolation",
    "missed-run and outage recovery",
    "rollback proof",
    "sustained soak",
    "zero critical regressions",
    "JARVIS independent assurance",
    "CFBE benchmark/value pass",
    "current Sentinel observation",
    "canonical-state synchronization",
    "applicable owner/effect gate satisfaction"
  ],
  "forbidden_terminal_substitutes": [
    "source exists",
    "configuration exists",
    "credential reference exists",
    "HTTP 200",
    "health response",
    "queue DONE without semantic proof",
    "CI pass",
    "screenshot",
    "historical success",
    "one-way connectivity",
    "bidirectional transport without resilience",
    "deployment without runtime proof",
    "provider visibility without authenticated semantic readback"
  ],
  "terminal_claims_requiring_gold_standard": [
    "ACTIVE",
    "CONNECTED",
    "CUTOVER_COMPLETE",
    "DEPLOYED",
    "DONE",
    "COMPLETE",
    "COMPLETED",
    "ESTABLISHED",
    "FULLY_OPERATIONAL",
    "MIGRATION_COMPLETE",
    "PRODUCTION_READY",
    "RESTORED",
    "SERVING",
    "CLOSED"
  ],
  "enforcement": {
    "fail_closed": true,
    "safe_independent_lanes_continue": true,
    "provider_or_owner_blockers_remain_open_not_completed": true,
    "not_applicable_requires_explicit_justification_and_proof": true,
    "legacy_retirement_requires_successor_fully_established": true,
    "cfbe_score_promotion_requires_observed_evidence": true,
    "jarvis_may_hold_false_completion": true,
    "sentinel_must_detect_staleness_and_regression": true,
    "sovara_must_continue_or_reroute_until_gold_standard": true
  },
  "evidence_minimum": [
    "timestamped proof references",
    "operation-specific semantic readback",
    "direction-specific connection proof",
    "identity and authority readback",
    "recovery and rollback receipts",
    "independent assurance",
    "current canonical-state update"
  ],
  "truth_boundary": "This rule raises the terminal acceptance standard; it does not fabricate provider authority or erase intermediate evidence. Work below FULLY_ESTABLISHED remains open and must continue, reroute, or wait at the exact external gate."
}
