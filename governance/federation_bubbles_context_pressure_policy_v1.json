    "CANONICAL_SOURCE",
    "SEARCH",
    "TARGETED_SLICE",
    "COMPACT_CAPSULE",
    "WORK"
  ],
  "prohibited_default_behaviors": [
    "FULL_BIBLE_HYDRATION",
    "FULL_KDV_SCAN",
    "UNBOUNDED_PROVIDER_LOG_HYDRATION",
