{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://federation.local/schemas/failure-win-receiver-manifest-v2.json",
  "title": "Failure-to-Operational-Win v2 Receiver Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_from",
    "generated_at",
    "source_complete",
    "complete",
    "behavior_complete",
    "receiver_count",
    "v2_behavior_proven_count",
    "v2_invoked_open_count",
    "v1_behavior_proven_v2_pending_count",
    "snapshot_sha256",
    "anomalies",
    "receivers"
  ],
  "properties": {
    "schema_version": {"const": "failure-win.receiver-manifest.v2"},
    "generated_from": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "source_complete": {"type": "boolean"},
    "complete": {"type": "boolean"},
    "behavior_complete": {"type": "boolean"},
    "receiver_count": {"type": "integer", "minimum": 1},
    "v2_behavior_proven_count": {"type": "integer", "minimum": 0},
    "v2_invoked_open_count": {"type": "integer", "minimum": 0},
    "v1_behavior_proven_v2_pending_count": {"type": "integer", "minimum": 0},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail", "receiver_id"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "receiver_id": {"type": "string"}
        }
      }
    },
    "receivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receiver_id",
          "canonical_control",
          "primary_id",
          "registry_status",
          "latest_event_id",
          "latest_event_timestamp",
          "latest_event_kernel_version",
          "kernel_invoked",
          "behavior_proven",
          "independent_readback",
          "current",
          "evidence_refs",
          "receiver_state"
        ],
        "properties": {
          "receiver_id": {"type": "string", "minLength": 1},
          "canonical_control": {"type": "string"},
          "primary_id": {"type": "string", "minLength": 1},
          "registry_status": {"const": "REGISTERED_V2"},
          "latest_event_id": {"type": "string"},
          "latest_event_timestamp": {"type": "string"},
          "latest_event_kernel_version": {"type": "string"},
          "kernel_invoked": {"type": "boolean"},
          "behavior_proven": {"type": "boolean"},
          "independent_readback": {"type": "boolean"},
          "current": {"type": "boolean"},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "receiver_state": {
            "enum": [
              "REGISTERED_V2_BEHAVIOR_PENDING",
              "V2_EVENT_PRESENT_INVOCATION_OPEN",
              "V2_INVOKED_PROOF_OPEN",
              "V2_BEHAVIOR_PROVEN",
              "V1_BEHAVIOR_PROVEN_V2_PENDING",
              "HISTORICAL_EVENT_V2_PENDING"
            ]
          }
        }
      }
    }
  }
}
