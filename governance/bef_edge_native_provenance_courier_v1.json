    "native_host": {
      "allowed_extension_origins": ["apokbhjjgiaceigelkedcelcecfmgnia"],
      "network_listener": false,
      "network_client": false,
      "storage": "WINDOWS_DPAPI_CURRENT_USER_ENCRYPTED_CONTENT_ADDRESSED_SPOOL",
      "role": "LOCAL_ENCRYPTED_PROVENANCE_SPOOL"
    }
