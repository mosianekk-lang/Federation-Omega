{
  "schema": "FUSE-SELF-HOSTING-RD-MATCHED-EVAL-CONTROL-V1",
  "version": "1.0.0",
  "state": "SOURCE_CANDIDATE",
  "minimum_matched_pairs": 12,
  "minimum_real_pairs_for_promotion": 20,
  "required_match_keys": [
