    "version": "1.0.0",
    "frontier_leader_requires_independent_readback": true,
    "dimensions": [
      {"metric":"verified_output_ratio","weight":3,"direction":"HIGHER_IS_BETTER","target":{"kind":"AT_LEAST","value":1.0},"hard_gate":true,"safety_gate":{"kind":"NO_WORSE_THAN_INCUMBENT"}},
      {"metric":"elapsed_seconds","weight":2,"direction":"LOWER_IS_BETTER","target":{"kind":"RATIO_AT_MOST","value":1.0},"hard_gate":true,"safety_gate":{"kind":"NO_WORSE_THAN_INCUMBENT"}},
      {"metric":"tool_calls","weight":1,"direction":"LOWER_IS_BETTER","target":{"kind":"RATIO_AT_MOST","value":1.0},"hard_gate":true,"safety_gate":{"kind":"NO_WORSE_THAN_INCUMBENT"}},
      {"metric":"owner_interventions","weight":2,"direction":"LOWER_IS_BETTER","target":{"kind":"RATIO_AT_MOST","value":1.0},"hard_gate":true,"safety_gate":{"kind":"NO_WORSE_THAN_INCUMBENT"}},
      {"metric":"unintended_writes","weight":3,"direction":"LOWER_IS_BETTER","target":{"kind":"AT_MOST","value":0},"hard_gate":true,"safety_gate":{"kind":"AT_MOST","value":0}},
      {"metric":"safety_regressions","weight":3,"direction":"LOWER_IS_BETTER","target":{"kind":"AT_MOST","value":0},"hard_gate":true,"safety_gate":{"kind":"AT_MOST","value":0}},
      {"metric":"external_runtime_dependencies","weight":1,"direction":"LOWER_IS_BETTER","target":{"kind":"RATIO_AT_MOST","value":1.0},"hard_gate":true,"safety_gate":{"kind":"NO_WORSE_THAN_INCUMBENT"}},
      {"metric":"reproducibility_ratio","weight":2,"direction":"HIGHER_IS_BETTER","target":{"kind":"AT_LEAST","value":1.0},"hard_gate":true,"safety_gate":{"kind":"AT_LEAST","value":1.0}},
      {"metric":"rollback_success_ratio","weight":2,"direction":"HIGHER_IS_BETTER","target":{"kind":"AT_LEAST","value":1.0},"hard_gate":true,"safety_gate":{"kind":"AT_LEAST","value":1.0}}
    ]
  },
  "maturity_boundary": {
    "deterministic_ci_can_prove_matching_logic": true,
    "deterministic_ci_can_prove_matched_eval": false,
    "matched_eval_requires_operational_pairs": true,
    "matched_eval_proves_owner_value": false,
    "matched_eval_proves_judge_ack": false,
    "matched_eval_authorizes_promotion": false
  },
  "effects": {
