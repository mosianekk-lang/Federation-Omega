{
  "schema": "FUSE-MOBILE-MDTAF-V1",
  "version": "1.2.0",
  "owner": "Kim Kagiso Mosiane",
  "module_id": "FUSE_MOBILE_DIGITAL_TWIN_ASSURANCE_FABRIC",
  "purpose": "Provide a permanent, reusable, high-fidelity real-world mobile digital-twin and device-assurance capability for FUSE Mobile and future Federation mobile clients.",
  "authority_ceiling": "A1_INTERNAL",
  "external_effect_default": false,
  "truth_boundary": {
    "source_is_not_runtime": true,
    "virtual_device_is_not_physical_device": true,
    "owner_device_profile_uses_progressive_fidelity": true,
    "consent_bound_real_data_is_allowed_when_material": true,
    "literal_identifiers_require_demonstrated_test_value": true,
    "live_secret_clone_is_prohibited": true,
    "release_requires_runtime_evidence": true,
    "provider_or_store_mutation_requires_separate_authority": true,
    "offline_process_survival_alone_is_not_offline_proof": true,
    "security_receipt_must_match_exercised_apk_hash": true
  },
  "layers": [
    "LOCAL_STATIC_AND_TYPE_ASSURANCE",
    "ANDROID_AVD_DIGITAL_TWIN",
    "OWNER_REFERENCE_DEVICE_PROFILE",
    "REAL_WORLD_DEVICE_ECOLOGY_MODEL",
    "LIFECYCLE_AND_OFFLINE_FAULT_TESTS",
    "APK_CREDENTIAL_SCAN",
    "PERFORMANCE_AND_LOG_EVIDENCE",
    "CLOUD_VIRTUAL_DEVICE_MATRIX",
    "PHYSICAL_DEVICE_RELEASE_VALIDATION",
    "OWASP_MASVS_SECURITY_ASSURANCE",
    "RELEASE_CERTIFICATION"
  ],
  "owner_reference_device": {
    "role": "CANONICAL_BASELINE_DEVICE",
    "profile_class": "PRIVATE_HIGH_FIDELITY_REAL_WORLD_LAB",
    "capture_method": "ADB_PROGRESSIVE_FIDELITY_WITH_CONSENT_BOUND_ESCALATION",
    "public_source_storage_allowed": false,
    "capture_principle": "Do not discard a variable solely because it is personal or sensitive. Classify it by behavioral value, sensitivity, minimum fidelity needed and containment method, then use the least-sensitive representation that preserves the behavior under study.",
    "fidelity_ladder": [
      "L1_ENVIRONMENTAL_TWIN",
      "L2_BEHAVIORAL_ECOLOGY_TWIN",
      "L3_CONTENT_STRUCTURE_TWIN",
      "L4_CONSENT_BOUND_REAL_DATA_LAB"
    ],
    "l1_environmental_twin": [
      "manufacturer",
      "brand",
      "model",
      "android_release",
      "android_sdk",
      "security_patch",
      "abi",
      "screen_size",
      "screen_density",
      "font_scale",
      "ram_capacity",
      "data_partition_capacity",
      "locale",
      "timezone",
      "low_ram_flag",
      "battery_state",
      "thermal_state",
      "sim_configuration",
      "carrier_characteristics",
      "wifi_cellular_vpn_dns_proxy_state",
      "bluetooth_nfc_state",
      "accessibility_state",
      "work_profile_and_device_policy_state"
    ],
    "l2_behavioral_ecology_twin": [
      "installed_application_inventory",
      "application_versions",
      "permission_states",
      "background_process_pressure",
      "battery_optimization_state",
      "notification_load_characteristics",
      "account_provider_types",
      "network_transition_patterns",
      "storage_pressure",
      "multitasking_and_foreground_activity_patterns"
    ],
    "l3_content_structure_twin": [
      "contacts_count_and_field_shape",
      "message_thread_and_message_volume",
      "media_counts_types_sizes_and_metadata_shape",
      "document_counts_types_sizes_and_folder_structure",
      "application_private_data_structure_when_readable_and_test_relevant"
    ],
    "l4_consent_bound_real_data_lab": [
      "selected_real_contacts",
      "selected_real_messages",
      "selected_real_media_or_documents",
      "selected_application_private_data",
      "literal_hardware_or_subscriber_identifiers_only_when_the_literal_value_is_required_to_reproduce_behavior"
    ],
    "real_data_capture_requires": [
      "defined_test_or_research_hypothesis",
      "minimum_real_subset_needed",
      "private_non_repository_storage",
      "access_and_provenance_receipt",
      "explicit_sensitive_capture_acknowledgement"
    ],
    "secret_boundary": {
      "clone_into_twin": false,
      "classes": [
        "passwords",
        "private_keys",
        "authentication_tokens",
        "recovery_codes",
        "signing_secrets",
        "equivalent_live_credentials"
      ],
      "behavioral_substitutes": [
        "delegated_authentication",
        "scoped_test_credentials",
        "short_lived_tokens",
        "provider_native_test_accounts",
        "secure_keystore_or_enclave_operations"
      ]
    },
    "containment": [
      "private storage only",
      "encryption at rest and in transit where supported",
      "narrow access scope",
      "access and provenance receipts",
      "no accidental inclusion in public source logs screenshots prompts or build artifacts"
    ],
    "fidelity_rule": "Continuously compare the physical owner device, owner digital twin, generic device matrix and cloud/physical test devices. When the real phone reveals a new behavior, capture the causal variables, reproduce them at the lowest fidelity that preserves the effect, create a deterministic regression and explicitly track any physical-only gap."
  },
  "release_verdicts": [
    "RELEASE_VERIFIED",
    "RELEASE_VERIFIED_WITH_DECLARED_LIMITATIONS",
    "NOT_RELEASE_READY"
  ],
  "minimum_release_gates": [
    "TYPECHECK_PASS",
    "EXPO_DOCTOR_PASS",
    "ANDROID_BUILD_PASS",
    "APK_CREDENTIAL_SCAN_CLEAN",
    "APK_SECURITY_SMOKE_HASH_MATCH",
    "AVD_BOOT_PASS",
    "APK_INSTALL_PASS",
    "FIRST_LAUNCH_PASS",
    "RELAUNCH_PASS",
    "NETWORK_BASELINE_PASS",
    "OFFLINE_FAULT_INJECTION_VERIFIED",
    "OFFLINE_LAUNCH_PASS",
    "NETWORK_RECOVERY_PASS",
    "RECOVERY_RELAUNCH_PASS",
    "NO_FATAL_CRASH_OR_ANR",
    "EVIDENCE_RECEIPT_COMPLETE"
  ],
  "release_expansion_gates": [
    "OWNER_REFERENCE_PROFILE_APPLIED_OR_DECLARED_UNAVAILABLE",
    "OWNER_REAL_WORLD_ECOLOGY_MODELED_OR_DECLARED_UNAVAILABLE",
    "CLOUD_VIRTUAL_DEVICE_MATRIX",
    "PHYSICAL_DEVICE_VALIDATION_FOR_SIGNIFICANT_RELEASE",
    "OWASP_MASVS_MASTG_REVIEW",
    "PERFORMANCE_BASELINE_REGRESSION",
    "ACCESSIBILITY_AND_VISUAL_REGRESSION"
  ],
  "execution_surfaces": {
    "github_actions": "OWNER_DISPATCHED_READ_ONLY_COURT",
    "local_android_sdk": "SAFE_INTERNAL",
    "firebase_test_lab": "PROVIDER_GATED_OPTIONAL_UNTIL_AUTHORITY_READBACK",
    "physical_owner_device": "OWNER_CONTROLLED_HIGH_FIDELITY_REFERENCE_TARGET"
  },
  "evidence_contract": {
    "runtime_outputs_are_artifacts_not_canonical_source": true,
    "required": [
      "source_sha",
      "apk_sha256",
      "security_scan_apk_sha256",
      "artifact_hash_binding_state",
      "device_profile_class",
      "android_api",
      "boot_state",
      "install_state",
      "launch_state",
      "relaunch_state",
      "network_baseline_state",
      "connectivity_loss_state",
      "offline_state",
      "network_recovery_state",
      "recovery_launch_state",
      "fatal_log_scan_state",
      "screenshots",
      "certificate"
    ]
  },
  "ao_cra": {
    "policy": "AO-CRA-FEDERATION-INHERITANCE-V1",
    "open_builds_on_missing_physical_profile_or_provider_authority": true,
    "workaround_is_not_deployment": true
  }
}
