{
  "policy_id": "FEDOMEGA-ACTIONS-EXECUTION-PROTECTION-V1",
  "enforcement_surface": "GITHUB_ACTIONS_POLICY",
  "default": "DENY",
  "allowed_actors": ["mosianekk-lang"],
  "allowed_events": ["pull_request", "merge_group", "workflow_dispatch"],
  "event_exceptions": {
    ".github/workflows/github-airlock.yml": ["push"],
    ".github/workflows/evidenceops-resolve-ci.yml": ["push"],
    ".github/workflows/public-repository-leak-guard.yml": ["push"],
    ".github/workflows/superior-logic-ci.yml": ["push"],
    ".github/workflows/evidenceops-fevx-adapter-verify.yml": ["push"],
    ".github/workflows/ipep-audio-engine-v2-ci.yml": ["push"],
    ".github/workflows/evidenceops-pst-corpus-v2-fanout-observer.yml": ["workflow_run"]
  },
  "blocked_events": ["pull_request_target", "repository_dispatch", "issue_comment"],
  "scheduled_execution": {
    "allowed": false,
    "target_architecture": "SEPARATE_PRIVATE_OPERATIONS_REPOSITORY"
  },
  "source_repository": {
    "default_workflow_permissions": "read",
    "allow_actions_to_approve_pull_requests": false,
    "runtime_state_commits": false,
    "proof_storage": "ARTIFACT_OR_EXTERNAL_APPEND_ONLY_STORE"
  }
}
