{
  "schema": "LEX-AUTONOMOUS-STRATEGY-ENGINE-V1",
  "version": "0.1.0",
  "owner": "Kim Kagiso Mosiane",
  "engine_id": "LASE-001",
  "system_path": "systems/lex-autonomous-strategy",
  "authority_ceiling": "A1_INTERNAL",
  "external_effect_default": false,
  "formation_engine": "REQUIRED",
  "alpha_to_omega_foundry": "REQUIRED",
  "ao_cra": "REQUIRED",
  "inherits": [
    "FEDOMEGA-SURFACE-AWARENESS-V1",
    "FEDOMEGA-AWARENESS-BOOTSTRAP-V1",
    "FEDOMEGA-N-DIRECTIVE-V2",
    "AO-CRA-FEDERATION-INHERITANCE-V1",
    "LEX-EXTERNAL-ACTION-FIREWALL-V1"
  ],
  "mission": "Run autonomous internal legal retrieval, reconciliation, predictive strategy, adversarial simulation, evidence-ahead planning and learning while minimising owner burden and preserving owner control over consequential external effects.",
  "runtime_contract": {
    "default_mode": "READ_ONLY_AUTONOMOUS",
    "autonomous_internal_actions": [
      "restore matter state",
      "inventory accessible sources",
      "generate and rank retrieval routes",
      "retrieve through authorised read adapters when bound",
      "reconcile source and case state",
      "rank unknowns by information gain and decision impact",
      "maintain case twin",
      "run ten-step strategy lookahead",
      "run most-likely strongest and surprise opponent lanes",
      "simulate neutral and hostile tribunal response",
      "build future evidence queue",
      "form competing strategies",
      "run pre-mortem counterfactual and red-team tests",
      "prepare internal drafts and action packets",
      "record forecast snapshots and outcome calibration",
      "record terminal learning events",
      "create AO-CRA builds for capability gaps"
    ],
    "owner_reserved_actions": [
      "send or serve external communication",
      "file or submit legal process",
      "make formal admission or concession",
      "accept settlement or contract",
      "withdraw or abandon a legal route",
      "delete or mutate evidence",
      "disclose sensitive material to a new party",
      "execute destructive or high-impact provider mutation"
    ]
  },
  "access_before_ask": {
    "rule": "Owner request is last resort, not first retrieval route.",
    "required_sequence": [
      "current matter state",
      "current chat or supplied corpus when available",
      "matter control/source registers",
      "Google Drive/canonical corpus",
      "Gmail/provider sources where relevant",
      "PST and derivative-to-native recovery",
      "GitHub/Federation reusable state",
      "official current law sources where legal",
      "alternate proof and source routes",
      "owner-only personal knowledge or preference"
    ],
    "ask_owner_gate": "No material non-owner unknown may have an unexhausted authorised retrieval route.",
    "capability_gap_behavior": "Create/update AO-CRA build and continue unaffected lanes before owner handoff."
  },
  "predictive_strategy": {
    "minimum_horizon": 10,
    "steps": [
      "objective",
      "legal/procedural gate",
      "opponent immediate response",
      "opponent second-order pivot",
      "tribunal response",
      "future evidence dependency",
      "cross-lane/waiver/remedy consequence",
      "countermove/fallback",
      "worst-case/recovery",
      "pivot/stop trigger"
    ],
    "opponent_lanes": ["MOST_LIKELY", "STRONGEST", "SURPRISE_HIGH_IMPACT"],
    "prediction_is_fact": false,
    "prospective_calibration_required": true,
    "backcast_success_claims_prohibited": true
  },
  "learning": {
    "append_only": true,
    "hash_linked": true,
    "terminal_events": ["SUCCESS", "FAILURE", "CONSTRAINT"],
    "additional_events": ["CORRECTION", "RECOVERY", "INNOVATION_CANDIDATE", "EXPERIMENT_RESULT", "NEGATIVE_RESULT"],
    "repeated_failure_opens_circuit": true,
    "unchanged_retry_after_open_circuit": false,
    "authority_expansion_by_learning": false,
    "cross_case_trust_transfer": false
  },
  "proof_gates": {
    "source_build": ["branch file readback", "governance contract readback"],
    "deterministic_tested": ["unit test execution receipt"],
    "operational_verified": ["runtime execution", "health", "persistence", "rollback/readback"],
    "background_live": ["authorised scheduler/runtime receipt", "recurrence proof", "drift/health monitoring", "rollback proof"]
  },
  "truth_boundary": {
    "stored_source_proves_runtime": false,
    "source_build_proves_tests": false,
    "local_test_proves_provider_runtime": false,
    "engine_can_run_without_invocation_or_scheduler": false,
    "external_actions_can_execute_without_owner_gate": false,
    "hidden_cross_chat_access_claimed": false
  }
}
