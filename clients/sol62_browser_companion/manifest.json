{
  "manifest_version": 3,
  "name": "FUSE Sol 6.2 Browser Carrier",
  "version": "0.1.0",
  "description": "Detachable browser-carrier health relay for FUSE Sol 6.2. It does not modify ChatGPT controls or bypass provider policy.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8762/*",
    "http://localhost:8762/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}