{
  "manifest_version": 3,
  "name": "FUSE Sol 6.2 Browser Carrier",
  "version": "0.3.0",
  "description": "FUSE Sol 6.2 detachable browser carrier with typed, authority-gated ChatGPT browser control and durable failover.",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8762/*",
    "http://localhost:8762/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
