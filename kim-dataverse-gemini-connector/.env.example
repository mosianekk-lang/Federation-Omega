PORT=8080
KDV_PROVIDER=auto
GOOGLE_CLOUD_PROJECT=sov-hybrid-suite
GOOGLE_CLOUD_LOCATION=africa-south1
KDV_ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-pro
KDV_DEFAULT_MODEL=gemini-2.5-flash
KDV_MAX_REQUEST_BYTES=18000000
KDV_MAX_INLINE_AUDIO_BYTES=13000000
KDV_MAX_OUTPUT_TOKENS=8192
KDV_REQUEST_TIMEOUT_MS=120000
KDV_MAX_CONCURRENCY=4
KDV_DAILY_REQUEST_LIMIT=250
KDV_IDEMPOTENCY_TTL_MS=86400000
# Optional defense in depth. Cloud Run IAM remains the primary perimeter.
# KDV_SHARED_TOKEN=<Secret Manager injection only>
# Optional AI Studio Developer API route. Never commit this value.
# GEMINI_API_KEY=<Secret Manager injection only>
