{
  "schema": "FEDOMEGA-PHOENIX-EXPORT-POLICY-1",
  "version": "1.0.18",
  "core": {
    "include_extensions": [
      ".css",
      ".csv",
      ".html",
      ".js",
      ".json",
      ".md",
      ".proto",
      ".ps1",
      ".py",
      ".sh",
      ".sql",
      ".toml",
      ".ts",
      ".txt",
      ".xml",
      ".yaml",
      ".yml"
    ],
    "include_root_files": [
      ".gitignore",
      "LICENSE",
      "README.md",
      "SECURITY.md",
      "pyproject.toml"
    ],
    "excluded_prefixes": [
      ".bootstrap/",
      ".git/",
      ".github/",
      "deployment_receipts/",
      "phoenix-export-output/",
      "phoenix-freeze-output/",
      "runtime/",
      "tests/test_phoenix_"
    ],
    "excluded_test_globs": [
      "tests/test_phoenix_*",
      "tests/test_provider_airlock_activate.py",
      "tests/test_agent_governance_contract.py",
      "tests/test_pst_composite_runtime_contract.py",
      "tests/test_wif_hardening.py",
      "tests/test_airlock_stale_base_guard.py",
      "tests/test_ao_cra_federation_inheritance.py"
    ],
    "excluded_segments": [
      "__pycache__",
      "credentials",
      "drift",
      "heartbeat",
      "keys",
      "proofs",
      "queue",
      "receipts",
      "results",
      "secrets",
      "snapshots",
      "state",
      "vendor"
    ],
    "excluded_suffixes": [
      ".crt",
      ".der",
      ".jks",
      ".key",
      ".p12",
      ".pem",
      ".pfx",
      ".pyc"
    ],
    "secret_markers": [
      "github_pat_",
      "ghp_",
      "sk-proj-"
    ]
  },
  "ops": {
    "template_prefix": "phoenix/ops-template/",
    "required_files": [
      "README.md",
      ".gitignore",
      ".github/CODEOWNERS",
      "governance/OPS_CONTRACT.json",
      "governance/APPLY_ENTRYPOINT.json",
      "governance/CUTOVER_CANDIDATE_CONTRACT.json",
      "governance/PROVIDER_AUTHORITY_PROBE_CONTRACT.json",
      "governance/OWNER_SEALED_PACKET_CANDIDATE_CONTRACT.json",
      "governance/OWNER_CUSTODY_CEREMONY_CONTRACT.json",
      "governance/OWNER_CUSTODY_ATTESTATION_CONTRACT.json",
      "governance/PROVIDER_AUTHENTICATED_OWNER_ATTESTATION_CONTRACT.json",
      "governance/PROVIDER_ATTESTED_AUTHORIZATION_CONTRACT.json",
      "governance/OWNER_EXECUTION_HANDOFF_CONTRACT.json",
      "governance/OWNER_EXECUTION_EVIDENCE_INTAKE_CONTRACT.json",
      "provider_authority_probe.py",
      "provider_cutover_owner_authority_bound.py",
      "provider_cutover_authority_bound.py",
      "provider_cutover_candidate.py",
      "provider_cutover_guarded.py",
      "provider_cutover_v3_live_guard.py",
      "owner_sealed_packet.py",
      "owner_custody_ceremony.py",
      "owner_custody_attestation.py",
      "provider_authenticated_owner_attestation.py",
      "provider_attested_authorization.py",
      "owner_execution_handoff.py",
      "owner_execution_evidence_intake.py",
      "provider_cutover.py"
    ],
    "required_v3_files": [
      "provider_cutover_authorization_use.py",
      "provider_cutover_v3_1.py",
      "provider_cutover_v3_base.py",
      "provider_cutover_outcome_reconciler.py"
    ]
  },
  "invariants": {
    "core_workflow_count": 0,
    "core_nested_workflow_count": 0,
    "core_runtime_state_count": 0,
    "core_migration_control_test_count": 0,
    "ops_legacy_workflow_count": 0,
    "export_provider_dispatch_count": 0,
    "final_receipt_hash_mismatch_count": 0,
    "symlinks_allowed": false,
    "secret_marker_files_allowed": 0,
    "private_key_suffixes_allowed": 0
  }
}
