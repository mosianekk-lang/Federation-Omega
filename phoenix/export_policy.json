{
  "schema": "FEDOMEGA-PHOENIX-EXPORT-POLICY-1",
  "version": "1.0.7",
  "core": {
    "include_extensions": [
      ".css", ".csv", ".html", ".js", ".json", ".md", ".proto",
      ".ps1", ".py", ".sh", ".sql", ".toml", ".ts", ".txt",
      ".xml", ".yaml", ".yml"
    ],
    "include_root_files": [
      ".gitignore", "LICENSE", "README.md", "SECURITY.md", "pyproject.toml"
    ],
    "excluded_prefixes": [
      ".bootstrap/", ".git/", ".github/", "deployment_receipts/",
      "phoenix-export-output/", "phoenix-freeze-output/", "runtime/",
      "tests/test_phoenix_"
    ],
    "excluded_test_globs": [
      "tests/test_phoenix_*",
      "tests/test_provider_airlock_activate.py",
      "tests/test_agent_governance_contract.py",
      "tests/test_pst_composite_runtime_contract.py",
      "tests/test_wif_hardening.py",
      "tests/test_airlock_stale_base_guard.py"
    ],
    "excluded_segments": [
      "__pycache__", "credentials", "drift", "heartbeat", "keys", "proofs",
      "queue", "receipts", "results", "secrets", "snapshots", "state", "vendor"
    ],
    "excluded_suffixes": [
      ".crt", ".der", ".jks", ".key", ".p12", ".pem", ".pfx", ".pyc"
    ],
    "secret_markers": [
      "github_pat_", "ghp_", "sk-proj-"
    ]
  },
  "ops": {
    "template_prefix": "phoenix/ops-template/",
    "required_files": [
      "README.md", ".gitignore", ".github/CODEOWNERS",
      "governance/OPS_CONTRACT.json", "provider_cutover.py",
      "provider_cutover_authorization_use.py", "provider_cutover_v3_1.py",
      "provider_cutover_v3_base.py"
    ]
  },
  "invariants": {
    "core_workflow_count": 0,
    "core_nested_workflow_count": 0,
    "core_runtime_state_count": 0,
    "core_migration_control_test_count": 0,
    "ops_legacy_workflow_count": 0,
    "export_provider_dispatch_count": 0,
    "final_receipt_hash_mismatch_count": 0,
    "symlinks_allowed": false,
    "secret_marker_files_allowed": 0,
    "private_key_suffixes_allowed": 0
  }
}
