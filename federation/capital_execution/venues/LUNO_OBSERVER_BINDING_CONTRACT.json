{
  "schema": "FEDERATION-LUNO-OBSERVER-BINDING-CONTRACT-1",
  "version": "1.3.0",
  "project": "sov-hybrid-suite",
  "region": "africa-south1",
  "service": "federation-luno-observer",
  "service_account": "luno-observer@sov-hybrid-suite.iam.gserviceaccount.com",
  "default_mode": "PUBLIC_ONLY",
  "account_mode": "ACCOUNT_READ_ONLY",
  "research_only": true,
  "financial_effects": false,
  "provider_write_operations": false,
  "control_authority": {
    "engine_id": "JARVIS-ALPHA-OMEGA-5-SOVEREIGN",
    "engine_version": "ΑΩ5.0",
    "canonical_governance_contract": "governance/jarvis_ao5_forensic_decision_intelligence_v1.json",
    "canonical_spec_sha256": "773ee29579605aa3f3b956a27af3e5ac5dd7c3a28e524f61cd8c392451366443",
    "realityguard_execution_receipt_required": true,
    "completion_standard": [
      "AUTHORISATION",
      "EXECUTION",
      "TARGET_READBACK",
      "RECEIPT"
    ],
    "failure_learning": "Ω-FLM",
    "method_science": "Ω-SCIENTIST",
    "consequential_external_action_requires_owner_approval": true,
    "provider_state_must_match_readback": true
  },
  "mission_arbitration": {
    "contract": "governance/federation_mission_arbitration_fabric_v1.json",
    "implementation": "federation.orchestration.mission_arbitration",
    "capability_discovery_before_route_selection": true,
    "failure_memory_before_retry": true,
    "current_main_prewrite_fence_required": true,
    "cross_workstream_overlap_detection_required": true,
    "known_failure_fingerprint": "GOOGLE_WIF_INVALID_TARGET",
    "known_failed_route": "GITHUB_TO_GOOGLE_WIF",
    "provider_retry_requires_newer_wif_recovery_proof": true,
    "source_and_provider_readiness_are_separate": true,
    "blocked_provider_lane_does_not_freeze_safe_research_lanes": true
  },
  "credential_binding": {
    "legacy_secret_names_accepted": false,
    "dedicated_secret_names": [
      "luno-observer-key-id",
      "luno-observer-key-material",
      "luno-observer-permission-proof"
    ],
    "permission_proof_schema": "LUNO-OBSERVER-PERMISSION-PROOF-1",
    "exact_permissions": [
      "Perm_R_Balance",
      "Perm_R_Transactions",
      "Perm_R_Orders"
    ],
    "write_permissions_forbidden": true,
    "key_id_fingerprint_binding_required": true,
    "raw_values_in_source_logs_receipts": false
  },
  "provider_canaries": {
    "public": [
      "GET /health",
      "GET /ready",
      "GET /v1/public/ticker?pair=XBTZAR",
      "GET /v1/public/orderbook?pair=XBTZAR"
    ],
    "authenticated": [
      "GET /v1/account/semantic-canary?pair=XBTZAR"
    ],
    "authenticated_response_policy": "structural counts and hashes only; no balance, order, transaction or fee values persist to receipts"
  },
  "deployment": {
    "container": "federation/capital_execution/venues/Dockerfile.luno_observer",
    "private_cloud_run": true,
    "min_instances": 0,
    "max_instances": 1,
    "concurrency": 1,
    "zero_traffic_canary_first": true,
    "promotion_requires_canary": true,
    "rollback_required": true,
    "scheduler": false
  },
  "states": [
    "SOURCE_IMPLEMENTED_PROVIDER_UNBOUND",
    "PUBLIC_MARKET_PROVIDER_VERIFIED",
    "CREDENTIAL_PERMISSION_PROOF_REQUIRED",
    "OBSERVER_BOUND",
    "PROVIDER_CANARY_FAILED"
  ],
  "invariants": [
    "LEGACY_TRADING_CREDENTIALS_ARE_NEVER_AUTO_IMPORTED",
    "READ_ONLY_PRESET_NAME_IS_NOT_PERMISSION_PROOF",
    "EXACT_PERMISSION_NAMES_PLUS_KEY_FINGERPRINT_ARE_REQUIRED",
    "NO_POST_PUT_PATCH_DELETE_PROVIDER_ROUTE",
    "NO_ORDER_CONVERSION_SEND_WITHDRAWAL_TRANSFER_METHOD",
    "NO_PRIVATE_ACCOUNT_VALUES_IN_PROVIDER_RECEIPT",
    "NO_SCHEDULER_OR_AUTONOMOUS_EXECUTION_LOOP",
    "SHADOW_MODE_REMAINS_THE_CAPITAL_CEILING",
    "PUBLIC_PROVIDER_SUCCESS_DOES_NOT_IMPLY_ACCOUNT_BINDING",
    "JARVIS_AO5_REALITYGUARD_CONTROLS_PROVIDER_STATE_CLAIMS",
    "MISSION_ARBITRATION_PRECEDES_PROVIDER_ROUTE_RETRY",
    "KNOWN_WIF_INVALID_TARGET_ROUTE_REQUIRES_RECOVERY_PROOF_BEFORE_REUSE"
  ]
}
