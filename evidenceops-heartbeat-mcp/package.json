{
  "name": "evidenceops-heartbeat-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OAuth-protected, tool-only MCP gateway for the EvidenceOps capability heartbeat.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.1.0",
    "google-auth-library": "11.0.0",
    "jose": "6.2.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
