{
  "schema": "EVIDENCEOPS-PERMANENT-CLOUD-CAPABILITY-1",
  "version": 1,
  "owner": "Kim Kagiso Mosiane",
  "directive_refs": ["DIR-007", "DIR-012", "DIR-018", "DIR-022", "DIR-029", "DIR-040"],
  "owner_directive": "Allow EvidenceOps full project control to be available to all EvidenceOps systems, subsystems, AI agents and other elements under EvidenceOps.",
  "scope": {
    "target_project": "sov-hybrid-suite",
    "quota_project": "sov-hybrid-suite",
    "caller_project_default": "sov-hybrid-suite",
    "resource_scope": "projects/sov-hybrid-suite",
    "control_breadth": "FULL_PROJECT_CONTROL",
    "participants": [
      "evidenceops://systems/*",
      "evidenceops://subsystems/*",
      "evidenceops://ai-agents/*",
      "evidenceops://workers/*",
      "evidenceops://nodes/*",
      "evidenceops://elements/*"
    ]
  },
  "inheritance": {
    "mode": "MANDATORY_ROOT_INHERITANCE",
    "automatic": true,
    "new_elements_inherit_by_default": true,
    "explicit_opt_out_allowed": false,
    "readiness_fails_when_unbound": true,
    "remediation": "AUTO_REGISTER_BIND_CANARY_READBACK",
    "credential_distribution": "PROHIBITED",
    "execution_route": "CENTRAL_GOVERNED_OPERATOR_AND_SECURE_CAPABILITY_BOX"
  },
  "control_families": [
    "asset-and-capability-discovery",
    "service-usage-and-api-management",
    "cloud-run-services-jobs-revisions-and-traffic",
    "cloud-build-and-artifact-registry",
    "iam-service-accounts-policies-and-workload-identity",
    "secret-manager-metadata-versions-rotation-and-bindings",
    "pubsub-scheduler-logging-monitoring-and-alerting",
    "storage-databases-networking-kms-and-vertex-ai",
    "deployment-repair-rollback-recovery-and-provider-readback",
    "google-api-operations-within-the-project-boundary"
  ],
  "routes": {
    "cloud_runtime": {
      "authentication": "CLOUD_RUN_USER_MANAGED_SERVICE_IDENTITY_ADC",
      "operator_service": "evidenceops-cloud-control-internal",
      "capability_service": "evidenceops-secure-capability-box"
    },
    "github": {
      "authentication": "WORKLOAD_IDENTITY_FEDERATION",
      "deployer_identity": "evidenceops-cloud-operator"
    },
    "cloud_shell": {
      "authentication": "GOOGLE_USER_ADC_TO_GOVERNED_OPERATOR"
    },
    "chat": {
      "authentication": "SUPPORTED_MCP_ADAPTER_TO_SECURE_CAPABILITY_BOX",
      "raw_credentials": false
    }
  },
  "secrets": {
    "store": "GOOGLE_SECRET_MANAGER",
    "raw_values_in_contracts_logs_prompts_or_receipts": false,
    "service_identity_binding": true,
    "exact_version_for_effectful_capabilities": true
  },
  "proof": {
    "source_state": "IMPLEMENTED",
    "hosted_ci_state": "OPEN",
    "wif_token_exchange_state": "UNVERIFIED_IN_CURRENT_CHAT",
    "runtime_identity_state": "UNVERIFIED_IN_CURRENT_CHAT",
    "provider_canary_state": "OPEN",
    "semantic_readback_state": "OPEN",
    "permanence_state": "OPEN_UNTIL_SCHEDULED_MULTI_CYCLE_READBACK",
    "completion_claim": false
  }
}
