FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 HOST=0.0.0.0
WORKDIR /app
RUN useradd --create-home --uid 10001 cios && mkdir -p /data && chown -R cios:cios /data
COPY evidenceops /app/evidenceops
USER 10001
EXPOSE 8080
CMD ["python", "-m", "evidenceops.capital_intelligence_os.provider_runtime"]
