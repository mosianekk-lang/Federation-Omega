{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://federation-omega.local/evidenceops/fevx-mcoe/mission-contract.schema.json",
  "title": "EvidenceOps FEVX-MCOE Mission Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "directive", "canonical_state", "capability_map", "route", "proof_plan", "authority", "status"],
  "properties": {
    "mission_id": {"type": "string", "minLength": 8},
    "directive": {"type": "string", "minLength": 1},
    "canonical_state": {"type": "string", "minLength": 1},
    "capability_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement", "capability", "availability", "proof_method"],
        "properties": {
          "requirement": {"type": "string"},
          "capability": {"type": "string"},
          "availability": {"enum": ["ACTIVE", "BUILT", "HISTORICAL", "PARTIAL", "BLOCKED", "UNVERIFIED"]},
          "proof_method": {"type": "string"}
        }
      }
    },
    "route": {
      "type": "object",
      "required": ["mode", "steps", "rollback"],
      "properties": {
        "mode": {"enum": ["DIRECT", "COMPOSED", "PROTOTYPE", "STAGED", "HUMAN_IN_THE_LOOP", "BACKGROUND_VERIFIED"]},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rollback": {"type": "string"}
      }
    },
    "proof_plan": {
      "type": "object",
      "required": ["execution_receipt", "readback", "red_team"],
      "properties": {
        "execution_receipt": {"type": "string"},
        "readback": {"type": "string"},
        "red_team": {"type": "string"}
      }
    },
    "authority": {
      "type": "object",
      "required": ["internal_authority", "external_release_required"],
      "properties": {
        "internal_authority": {"type": "boolean"},
        "external_release_required": {"type": "boolean"}
      }
    },
    "status": {"enum": ["PLANNED", "BUILDING", "TESTING", "EXECUTED", "READBACK_VERIFIED", "BLOCKED", "RELEASED"]}
  }
}