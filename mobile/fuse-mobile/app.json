{
  "expo": {
    "name": "FUSE Mobile",
    "slug": "fuse-mobile",
    "version": "0.3.0",
    "scheme": "fusemobile",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-google-signin/google-signin"
    ],
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "android": {
      "package": "com.federationomega.fusemobile"
    },
    "ios": {
      "bundleIdentifier": "com.federationomega.fusemobile",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
