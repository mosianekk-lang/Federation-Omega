{
  "name": "fuse-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web",
    "verify:web": "expo export --platform web --output-dir dist-web",
    "prebuild:android": "expo prebuild --platform android --no-install --clean",
    "android:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug --no-daemon"
  },
  "dependencies": {
    "@react-native-google-signin/google-signin": "16.1.5",
    "expo": "~55.0.0",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
