# Public configuration only. Never put provider API keys, service-account keys, refresh tokens or backend credentials here.
EXPO_PUBLIC_FEDERATION_GATEWAY_URL=https://gateway.example.invalid
# Public OAuth client ID of the IAP-protected resource. The installed Android/iOS OAuth client is a separate provider-side identity and must be allowlisted for IAP programmatic access.
EXPO_PUBLIC_FUSE_IAP_RESOURCE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
