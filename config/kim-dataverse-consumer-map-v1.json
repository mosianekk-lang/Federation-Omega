{
  "version": "KDV-CONSUMER-MAP-1.1-OMEGA47",
  "purpose": "Map who may read mutable KDV projections and what stronger sources must be consulted first.",
  "consumers": [
    {
      "consumer": "ChatBridge restore",
      "reads": [
        "CHATBRIDGE_NAMESPACE_REGISTRY",
        "CHATBRIDGE_CHECKPOINT_GENERATIONS",
        "CHATBRIDGE_OPERATING_PROFILES",
        "CHATBRIDGE_CONTROL",
        "CHATBRIDGE_CONTEXT_GUARD",
        "CHATBRIDGE_CONTEXT_CHECKPOINTS",
        "CHATBRIDGE_PLAYBOOK_RULES",
        "CHATBRIDGE_PLAYBOOK_RELEASES"
      ],
      "must_reconcile": [
        "latest exact namespace/generation/handoff/checkpoint fingerprint",
        "generation-bound operating profile",
        "conversation exhaustion guard and write-ahead checkpoint policy",
        "bound empirical playbook and promotion policy",
        "query-time source provider read when source state can change the next action",
        "latest provider receipts and restore attestation"
      ],
      "risk": "stale context reintroduction, generic-alias misroute or silent loss of guard/playbook policy"
    },
    {
      "consumer": "ChatBridge empirical learning and playbook compiler",
      "reads": [
        "CHATBRIDGE_CONTEXT_GUARD",
        "CHATBRIDGE_CONTEXT_CHECKPOINTS",
        "CHATBRIDGE_LEARNING_EVENTS",
        "CHATBRIDGE_PLAYBOOK_RULES",
        "CHATBRIDGE_PLAYBOOK_RELEASES"
      ],
      "must_reconcile": [
        "evidence hierarchy and exact evidence references",
        "privacy and matter-wall classification",
        "independent support count",
        "provider or reproduced-canary promotion gate",
        "verified contradictions and supersession",
        "zero automatic provider/domain authority or maturity inheritance"
      ],
      "risk": "unsafe global rule propagation, sensitive-data leakage, documentation-only overpromotion or false platform guarantees"
    },
    {
      "consumer": "Federation maturity controller",
      "reads": [
        "FEDERATION_CAPABILITY_TWINS",
        "FEDERATION_STAGE_RUNTIME",
        "FEDERATION_DOMINANCE_CONTROLLER"
      ],
      "must_reconcile": [
        "qualified runtime attestations",
        "shadow/adversarial/canary receipts",
        "provider proof scope"
      ],
      "risk": "maturity inheritance or split-brain"
    },
    {
      "consumer": "Master/Live Bible projection",
      "reads": [
        "FEDERATION_BIBLE_SYNC",
        "append-only deltas"
      ],
      "must_reconcile": [
        "latest evidence receipts",
        "as-of timestamps"
      ],
      "risk": "human-readable projection outranking evidence"
    },
    {
      "consumer": "Bubbles/ChatGov assurance",
      "reads": [
        "PRE_OWNER_ASSURANCE_GATE",
        "ASSURANCE_RECEIPTS",
        "ASSURANCE_METRICS",
        "FEDERATION_FAILURE_MEMORY"
      ],
      "must_reconcile": [
        "open prospective case state",
        "failure corrections/supersession"
      ],
      "risk": "false assurance or hindsight leakage"
    },
    {
      "consumer": "TruthGrid/EvidenceOps writers",
      "reads": [
        "live provider sheet schema",
        "typed KDV schema contract",
        "FEDERATION_FAILURE_MEMORY"
      ],
      "must_reconcile": [
        "schema version",
        "target identity",
        "writer readback"
      ],
      "risk": "schema/type drift or wrong-target mutation"
    },
    {
      "consumer": "Offline backup/ETL",
      "reads": [
        "XLSX export"
      ],
      "must_reconcile": [
        "XLSX semantic decoder",
        "Google-to-XLSX sheet-name transform",
        "provider checkpoint metadata"
      ],
      "risk": "serialization misinterpretation or truncated sheet identity"
    }
  ],
  "truth_boundary": "Public-safe consumer contract. Exact private row identities, matter facts and provider credentials remain outside this file."
}
