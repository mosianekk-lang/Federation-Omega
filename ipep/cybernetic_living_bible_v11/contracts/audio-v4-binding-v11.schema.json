{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://federation-omega.local/contracts/audio-v4-binding-v11.schema.json",
  "title": "EvidenceOps Audio v4 Cybernetic Snapshot Binding",
  "type": "object",
  "required": [
    "processed_units",
    "emitted_segment_units",
    "zero_segment_units",
    "failed_units",
    "transcript_state"
  ],
  "properties": {
    "processed_units": {"type": "integer", "minimum": 0},
    "emitted_segment_units": {"type": "integer", "minimum": 0},
    "zero_segment_units": {"type": "integer", "minimum": 0},
    "failed_units": {"type": "integer", "minimum": 0},
    "transcript_state": {"type": "string"},
    "exact_quote_requested": {"type": "boolean"},
    "human_listened_to_exact_window": {"type": "boolean"},
    "translated_quote_requested": {"type": "boolean"},
    "bilingual_human_verified": {"type": "boolean"},
    "signed_attestation_sha256": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
