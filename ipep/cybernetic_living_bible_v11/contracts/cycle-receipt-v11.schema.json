{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://federation-omega.local/contracts/cycle-receipt-v11.schema.json",
  "title": "Omega Cybernetic Cycle Receipt v11",
  "type": "object",
  "required": [
    "contract",
    "cycle_id",
    "fixture_class",
    "started_at",
    "completed_at",
    "input_sha256",
    "output_sha256",
    "receipt_hash",
    "terminal_event",
    "cycle_state",
    "mission_delta_before",
    "mission_delta_after",
    "closure_rate",
    "signals",
    "state_vector",
    "decisions",
    "checks",
    "metrics",
    "open_constraints",
    "truth_boundary"
  ],
  "properties": {
    "contract": {"const": "OMEGA_CYBERNETIC_CYCLE_RECEIPT_V11"},
    "cycle_id": {"type": "string", "minLength": 1},
    "fixture_class": {"type": "string"},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_receipt_hash": {"type": ["string", "null"]},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_event": {"enum": ["SUCCESS", "FAILURE", "CONSTRAINT"]},
    "cycle_state": {"type": "string"},
    "mission_delta_before": {"type": "integer", "minimum": 0},
    "mission_delta_after": {"type": "integer", "minimum": 0},
    "closure_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "signals": {"type": "array"},
    "state_vector": {"type": "array"},
    "decisions": {"type": "array"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "metrics": {"type": "object"},
    "open_constraints": {"type": "array", "items": {"type": "string"}},
    "truth_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
