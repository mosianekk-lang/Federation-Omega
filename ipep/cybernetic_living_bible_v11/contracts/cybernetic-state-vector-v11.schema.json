{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://federation-omega.local/contracts/cybernetic-state-vector-v11.schema.json",
  "title": "Omega Cybernetic State Observation v11",
  "type": "object",
  "required": [
    "variable",
    "target",
    "observed",
    "error",
    "tolerance",
    "status",
    "confidence",
    "evidence"
  ],
  "properties": {
    "variable": {"type": "string", "minLength": 1},
    "target": {"type": ["number", "null"]},
    "observed": {"type": ["number", "null"]},
    "error": {"type": ["number", "null"]},
    "tolerance": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["HOMEOSTATIC", "DRIFT", "UNMEASURED"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
