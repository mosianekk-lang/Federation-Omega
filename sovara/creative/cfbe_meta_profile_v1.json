{
  "schema": "SOVARA-CREATIVE-CFBE-META-PROFILE-V1",
  "version": "1.0.0",
  "comparison_rule": "BEST_OF_BREED_COMPOSITE_NOT_VENDOR_AVERAGE",
  "freshness_rule": "STALE_OBSERVATIONS_MAY_NOT_SILENTLY_DEFINE_CURRENT_FRONTIER",
  "scientist_rule": "MATERIAL_GAPS_REQUIRE_COMPETING_HYPOTHESES_PREDICTIONS_FALSIFIERS_PRIMARY_METRIC_AND_ROLLBACK",
  "promotion_rule": "BENCHMARK_EVIDENCE_AND_CI_DO_NOT_INHERIT_PROVIDER_RUNTIME_REPEAT_SOAK_OR_VALUE_PROOF",
  "ten_x_rule": {
    "minimum_multiplier": 10.0,
    "requires_positive_measured_baseline": true,
    "ratio_metrics": [
      "OWNER_TECHNICAL_INTERVENTIONS_PER_MISSION",
      "OWNER_TOOL_SWITCHES_PER_MISSION",
      "FAILURE_RECOVERY_SECONDS",
      "REFERENCE_TO_PRODUCTION_PLAN_SECONDS",
      "FRONTIER_GAP_TO_TESTED_CANDIDATE_SECONDS",
      "SAFE_PRODUCTION_THROUGHPUT"
    ],
    "non_ratio_quality_target": "FRONTIER_PLUS"
  },
  "protected_dimensions": [
    "OWNER_AUTHORITY",
    "PRIVACY",
    "PROOF_COMPLETENESS",
    "REVERSIBILITY",
    "NO_CRITICAL_REGRESSION"
  ]
}
