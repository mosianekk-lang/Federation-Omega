{
  "manifest_version": 3,
  "name": "ChatBridge Companion for ChatGPT",
  "version": "0.2.0",
  "description": "Prepares bounded continuity capsules and adds Start a new chat via ChatBridge at ChatGPT conversation limits.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "src/background.js"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["src/bridge-core.js", "src/content-script.js"],
    "css": ["src/styles.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options/options.html"
}
