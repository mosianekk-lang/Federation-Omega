SEB_HOST=127.0.0.1
SEB_PORT=8080
SEB_ENABLE_OPENROUTER=0
SEB_POLICY_BACKEND=opa
SEB_OPA_URL=http://127.0.0.1:8181/v1/data/seb/decision
SEB_OPA_TIMEOUT_SECONDS=3
# OPA_IMAGE must be an immutable, tested image digest (name@sha256:...).
SEB_MTLS_REQUIRED=0
SEB_SVID_CERT=/run/seb-svid/svid.pem
SEB_SVID_KEY=/run/seb-svid/svid-key.pem
SEB_TRUST_BUNDLE=/run/seb-svid/bundle.pem
SEB_ALLOWED_CLIENT_SPIFFE_ID=spiffe://federation.local/ns/seb/sa/mission-client
# OPENROUTER_API_KEY is intentionally absent. Supply only through a secret manager in a qualified runtime.
